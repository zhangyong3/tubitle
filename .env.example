# 生成一个仅供自己使用的长随机字符串，扩展设置中填写相同值
PERSONAL_ACCESS_TOKEN=

# 可选：填写已加载扩展的 ID；多个 ID 用逗号分隔。留空时允许任意 Chrome 扩展来源，
# 但 API 仍要求 PERSONAL_ACCESS_TOKEN。
ALLOWED_EXTENSION_IDS=

# 至少配置一种翻译服务
MICROSOFT_TRANSLATOR_KEY=
MICROSOFT_TRANSLATOR_REGION=
MICROSOFT_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

GOOGLE_TRANSLATE_API_KEY=

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# OpenAI Chat Completions 兼容接口
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
