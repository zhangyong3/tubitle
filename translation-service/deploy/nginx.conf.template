limit_req_zone $server_name zone=tubitle_global:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=tubitle_client:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=tubitle_health:10m rate=10r/s;
limit_conn_zone $server_name zone=tubitle_connections:10m;

server {
    listen 80;
    server_name __DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/www/tubitle-acme; }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TubitleTLS:10m;
    server_tokens off;
    client_max_body_size 16k;
    client_body_timeout 10s;
    limit_req_status 429;
    limit_conn_status 429;
    access_log /var/log/nginx/tubitle-access.log;
    error_log /var/log/nginx/tubitle-error.log;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Authorization "";
    proxy_connect_timeout 2s;
    proxy_read_timeout 100s;
    proxy_send_timeout 10s;
    proxy_next_upstream off;

    location = /health {
        limit_except GET { deny all; }
        limit_req zone=tubitle_health burst=20 nodelay;
        proxy_pass http://127.0.0.1:18081;
    }
    location = /v1/translate {
        if ($tubitle_authorized = 0) { return 401; }
        limit_except POST { deny all; }
        limit_req zone=tubitle_global burst=8 nodelay;
        limit_req zone=tubitle_client burst=8 nodelay;
        limit_conn tubitle_connections 8;
        proxy_pass http://127.0.0.1:18081;
    }
    location / { return 404; }
}
